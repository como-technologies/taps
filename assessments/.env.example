# Amaker Configuration
#
# Copy this file to .env. dotenvy is used by each of the three binaries
# (amaker-author, amaker-assess, amaker-analyze) at startup. Variables are
# prefixed AUTHOR_ / ASSESS_ / ANALYZE_ so the three can coexist in one .env.
#
# ANTHROPIC_API_KEY is unprefixed — it's a third-party provider variable
# (the same name the Anthropic SDK and `claude` CLI use).

# ======================
# LLM (required for amaker-author; unused by assess + analyze)
# ======================
ANTHROPIC_API_KEY=sk-ant-xxxx

# Optional: pin a specific model. Must match an id returned by Anthropic's
# /v1/models endpoint for this key. If unset, the newest Sonnet is used.
# AUTHOR_AI_MODEL=claude-sonnet-4-5

# ======================
# amaker-author (port 3000) — authoring UI
# ======================
# AUTHOR_HOST=127.0.0.1
# AUTHOR_PORT=3000
# AUTHOR_DATA_DIR=./data
# AUTHOR_LOG_LEVEL=info
# AUTHOR_QUESTIONS_MIN=3
# AUTHOR_QUESTIONS_MAX=12
# AUTHOR_QUESTIONS_GEN_RETRIES=3
# AUTHOR_ASSESS_BASE_URL=http://localhost:3001
# AUTHOR_ANALYZE_BASE_URL=http://localhost:3002
# AUTHOR_PUBLIC_URL=http://localhost:3000

# ======================
# amaker-assess (port 3001) — respondent UI
# ======================
# ASSESS_HOST=127.0.0.1
# ASSESS_PORT=3001
# ASSESS_DATA_DIR=./data
# ASSESS_LOG_LEVEL=info
# ASSESS_AUTHOR_BASE_URL=http://localhost:3000
# ASSESS_ANALYZE_BASE_URL=http://localhost:3002

# ======================
# amaker-analyze (port 3002) — results UI
# ======================
# ANALYZE_HOST=127.0.0.1
# ANALYZE_PORT=3002
# ANALYZE_DATA_DIR=./data
# ANALYZE_LOG_LEVEL=info
# ANALYZE_AUTHOR_BASE_URL=http://localhost:3000
# ANALYZE_ASSESS_BASE_URL=http://localhost:3001

# ======================
# Storage backend (all three binaries)
# ======================
# Each binary reads `<PREFIX>_STORAGE_BACKEND` independently. Default is
# `filesystem` (writes under <PREFIX>_DATA_DIR). Other options:
#   `s3_compatible` — rustfs (local dev), R2, B2, GCS-via-S3-interop, Hetzner…
#   `gcs`           — native Google Cloud Storage
#   `in_memory`     — process-local; tests and quick experiments only
#
# Example: point all three at a local rustfs (see `just rustfs-serve`):
# AUTHOR_STORAGE_BACKEND=s3_compatible
# AUTHOR_S3_ENDPOINT=http://localhost:9000
# AUTHOR_S3_BUCKET=amaker
# AUTHOR_S3_REGION=us-east-1
# AUTHOR_S3_ACCESS_KEY_ID=rustfsadmin
# AUTHOR_S3_SECRET_ACCESS_KEY=rustfsadmin
# (same with ASSESS_* and ANALYZE_* prefixes)

# ======================
# Logging (all three binaries)
# ======================
# Log format. Unprefixed — applies to whichever binary reads it. Unset:
# JSON when running on Cloud Run (K_SERVICE is set), pretty text locally.
#   json — Cloud Logging structured JSON (real `severity`)
#   text — pretty human-readable
# LOG_FORMAT=text
#
# Level is per-binary: AUTHOR_LOG_LEVEL / ASSESS_LOG_LEVEL / ANALYZE_LOG_LEVEL
# above. Takes `tracing` EnvFilter syntax, e.g.
#   AUTHOR_LOG_LEVEL=info,amaker_author::services::tools=debug
