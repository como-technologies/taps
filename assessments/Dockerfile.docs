# syntax=docker/dockerfile:1
#
# The amaker user manual (mdBook) as a static site, served on Cloud Run
# behind IAP. Build from the repo root:
#   docker build -f Dockerfile.docs -t amaker-docs .

# ---- build the book ----
FROM debian:bookworm-slim AS build
ARG MDBOOK_VERSION=0.5.2
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL \
    "https://github.com/rust-lang/mdBook/releases/download/v${MDBOOK_VERSION}/mdbook-v${MDBOOK_VERSION}-x86_64-unknown-linux-gnu.tar.gz" \
    | tar -xz -C /usr/local/bin mdbook
WORKDIR /src
COPY docs ./docs
RUN mdbook build docs   # book.toml build-dir → /src/target/book

# ---- serve ----
FROM nginx:1-alpine AS runtime
COPY --from=build /src/target/book /usr/share/nginx/html
# Cloud Run injects $PORT (default 8080); the nginx image renders it into
# the listen directive via envsubst on startup.
COPY deploy/docs-nginx.conf.template /etc/nginx/templates/default.conf.template
ENV PORT=8080
EXPOSE 8080
