#!/usr/bin/env bash
# Beat 5 — MEASURE. tuesday attributes the merged effort back to the
# decision that prompted it, in strict mode (every merged PR must be
# accounted for), and the cross-check asserts that Adopt (conduit verify)
# and Measure (tuesday) — two independent codebases — agree on the same
# ground truth. The loop closes: this report and beat 1's pulse signals
# are exactly what the NEXT assessment takes as --context.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
WORK="$(workdir)"
require_forge
beat_start

banner "BEAT 5 — MEASURE" "tuesday --strict + the Adopt<->Measure cross-check"
talking_point <<'EOF'
Adoption you can count, not activity you take on faith. tuesday reads the
merged PRs off the client's forge and rolls measured hours up per
decision — strict mode exits nonzero if even one merged PR is
unaccounted for. Then the double-entry bookkeeping: conduit's verify and
tuesday's report are two independent codebases, and the cross-check
asserts they agree on the same PR, the same effort label, the same
decision. Finally, the loop closes: this report plus the pulse signal
feed the next assessment — which is where this demo began.
EOF

[ -f "$WORK/conduit-verify.json" ] || die "no conduit-verify.json in the workdir — run beat-4-adopt first"
TUESDAY="$(require_repo tuesday)"

echo " RUN: tuesday-report --source gitea --owner como --repo client-corpus --monthly-hours 160 -o json --strict"
echo "      (= tuesday's own \`just dogfood-report client-corpus\`; token rides the env, never argv or git)"
TUESDAY_GITEA_TOKEN="$(reviewer_token)" \
    "$TUESDAY/target/debug/tuesday-report" --source gitea --owner como \
    --base-url "http://localhost:${FORGE_PORT:-3000}" \
    --repo client-corpus --year "$(date -u +%Y)" --month "$(date -u +%-m)" \
    --monthly-hours 160 -o json --strict >"$WORK/tuesday-report.json"
echo "   exit code: 0 (strict mode satisfied)"

evidence "decision-attributed effort (the Measure artifact)"
jq -r '"   \(.organization) \(.year)-\(.month): \(.allocations | length) allocation(s), \(.unallocated_prs | length) unallocated PR(s) [strict requires 0]"' \
    "$WORK/tuesday-report.json"
jq -r '.allocations[] | "   PR \(.pr_number) \"\(.pr_title)\" -> \(.adr_id) (\(.effort_score), \(.allocated_hours)h)"' \
    "$WORK/tuesday-report.json"
jq -r '.adr_totals | to_entries[] | "   adr_totals: \(.key) = \(.value)h"' "$WORK/tuesday-report.json"

echo
echo " RUN: cross-check (Adopt vs Measure — two codebases, one ground truth)"
(cd "$TUESDAY" && bash scripts/cross-check.sh "$WORK/conduit-verify.json" "$WORK/tuesday-report.json") | sed 's/^/   /'

# ── The KB lane: the measurement lands IN the client's knowledge base ──────
echo
echo " RUN: tuesday-report ... --kb corpus-space   (the same month, written as a measure-report page into the per-run KB space)"
KB_LOG="$WORK/tuesday-kb.stderr"
TUESDAY_GITEA_TOKEN="$(reviewer_token)" \
    "$TUESDAY/target/debug/tuesday-report" --source gitea --owner como \
    --base-url "http://localhost:${FORGE_PORT:-3000}" \
    --repo client-corpus --year "$(date -u +%Y)" --month "$(date -u +%-m)" \
    --monthly-hours 160 -o json --strict --kb "$WORK/corpus-space" >/dev/null 2>"$KB_LOG"
evidence "the measure-report page in the corpus space (decisions and measurements, one KB)"
KB_PAGE="$(sed -n 's/^kb: wrote //p' "$KB_LOG" | head -1)"
[ -n "$KB_PAGE" ] && [ -f "$KB_PAGE" ] || {
    cat "$KB_LOG" >&2
    die "tuesday-report --kb wrote no page"
}
echo "   page: $KB_PAGE"
grep -q '^adr_hours:' "$KB_PAGE" || die "measure-report page carries no adr_hours"
sed -n '/^adr_hours:/,/^---$/p' "$KB_PAGE" | sed '$d' | sed 's/^/   /'

# ── Optional close: query the space with llm-wiki (skip-with-notice) ───────
# Resolution: env LLM_WIKI_BIN -> sibling ../llm-wiki release build -> PATH.
# Optional by design (the pre-baked path promises nothing beyond docker):
# absent binary = a notice naming the knobs, never a failure.
LLM_WIKI="${LLM_WIKI_BIN:-}"
[ -z "$LLM_WIKI" ] && [ -x "$ROOT/../llm-wiki/target/release/llm-wiki" ] && LLM_WIKI="$ROOT/../llm-wiki/target/release/llm-wiki"
[ -z "$LLM_WIKI" ] && command -v llm-wiki >/dev/null 2>&1 && LLM_WIKI="$(command -v llm-wiki)"
if [ -n "$LLM_WIKI" ]; then
    echo
    echo " RUN: llm-wiki register + ingest + search   (the loop's artifacts, answerable as knowledge)"
    export LLM_WIKI_CONFIG="$WORK/llm-wiki-registry.toml" # run-scoped registry — never the operator's
    "$LLM_WIKI" spaces register "$WORK/corpus-space" --name client 2>&1 | sed 's/^/   /'
    "$LLM_WIKI" ingest . --wiki client 2>&1 | tail -2 | sed 's/^/   /'
    evidence "the harness question, answered from the client's own pages"
    # Capture, then trim: truncating the binary's stdout pipe mid-stream
    # (search | head) makes it abort on the broken pipe.
    "$LLM_WIKI" search "what did this decision cost" --wiki client >"$WORK/kb-search.txt" 2>/dev/null
    head -7 "$WORK/kb-search.txt" | sed 's/^/   /'
else
    note "llm-wiki binary not found — skipping the KB query close (set LLM_WIKI_BIN, build ../llm-wiki (cargo build --release), or install llm-wiki on PATH)"
fi

evidence "the closed loop"
echo "   next-period inputs ready: $WORK/tuesday-report.json + $WORK/pulse-report.json"
echo "   (beat 2 --live consumes them as --context — measurement steers the next assessment)"
beat_end "beat-5-measure"

echo " -> inspect: cat $WORK/corpus-space/wiki/measures/*.md   (the month, priced, beside the decisions)"
