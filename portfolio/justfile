# Default: list available recipes
default:
    @just --list

# Install project dependencies and tools
init:
    cargo install --locked mdbook mdbook-mermaid mdbook-gruvbox

# Run all CI checks (used by .github/workflows/ci.yml)
# ADR-corpus validation is the workspace-root `just adr-check`.
ci: book

# Build the book
book:
    mdbook build docs

# Serve the book locally with live reload
book-serve:
    mdbook serve docs --open

# Run mdbook tests (validates code blocks)
book-test:
    mdbook test docs

# Clean built book artifacts
book-clean:
    rm -rf target/book

# Clean all build artifacts
clean:
    rm -rf target
